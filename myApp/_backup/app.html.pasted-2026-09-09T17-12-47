<!--
  GENERATED by marketing/tv-demo/combine.js from describe-the-plant.html,
  run-the-shift.html and answer-for-it.html. Do not edit: change a chapter and
  re-run.

  One card at the head of each chapter — for a stand with a person on it.

  All three chapters back to back — describe the plant, run a shift on it, then
  answer for what left. Each chapter's stylesheet is scoped under a wrapper
  class, its ids are prefixed and its keyframes renamed, because the three were
  written independently and collide on their card and table classes. The chrome
  is shared and is not scoped: one top bar, one caption strip, one clock.
-->
<style>
/* ── inlined from shared/chrome.css ───────────────── */
/* ══════════════════════════════════════════════════════════════════════════
   Chrome shared by every Shopfloor MES TV demo: the stage, the top bar, the
   caption strip, the interstitial text slide, the cut between scenes, and the
   furniture the scenes are built out of.

   Inlined into each demo by build.js. Nothing here knows about any particular
   demo — everything demo-specific lives in that demo's own <style>.

   PALETTE
   -------
   The application's own, not an invented one. The fallbacks in
   main-ui/src/styles.scss name it outright:

       --smes-text        #1C2B3A     --smes-border    #DDE3EC
       --smes-text-muted  #8898AA     --smes-gray-lt   #F5F6F8
       --smes-teal        #0E8A72     --smes-teal-lt   #E0F5EE

   and the GP12 screens carry the deeper pair (#0C7A5E, #12A47E) plus the deep
   navy #002060 that the app uses for its dark grounds. So a teal pill here is
   the pill the operator sees, and the navy table head is the app's table head.

   Deliberately distinct from the other products' loops — attendance is purple,
   warehouse teal, heat treatment slate-and-ember, production monitor green,
   power meter blue. This one is navy-dominant with teal only as the accent,
   which is what the product actually looks like: dark headers and buttons,
   teal reserved for what the operator is meant to act on.
   ══════════════════════════════════════════════════════════════════════════ */

:root {
    --ink-dk:  #0A1F33;
    --ink:     #1C2B3A;   /* --smes-text */
    --navy:    #123A5C;   /* table heads, primary buttons, dark grounds */
    --navy-d:  #002060;
    --slate:   #4A5C6E;
    --mute:    #8898AA;   /* --smes-text-muted */
    --line:    #DDE3EC;   /* --smes-border */
    --bg:      #EEF2F6;
    --card:    #FFFFFF;

    --teal:    #0E8A72;   /* --smes-teal — the accent, and only ever the accent */
    --teal-d:  #0C7A5E;
    --teal-br: #56D7B4;   /* bright, for dark grounds */
    --teal-b:  #B7E0C8;
    --teal-l:  #E0F5EE;   /* --smes-teal-lt */

    --green:  #0C7A5E;   --green-l: #EAF6EF;   --green-b: #B7E0C8;
    --amber:  #B45309;   --amber-l: #FEF3E2;   --amber-b: #F1D3A0;
    --red:    #C0392B;   --red-l:   #FDECEC;   --red-b:   #F3C6C1;
    --slate-l:#F1F4F8;

    --safe:   64px;      /* title-safe inset — TVs overscan */
    --r:      14px;
}

* { box-sizing: border-box; }

html, body {
    margin: 0; padding: 0; height: 100%;
    background: #061420;              /* letterbox, not black — black shows panel glow */
    overflow: hidden;
    font-family: 'Segoe UI', system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    cursor: none;                      /* nobody is holding a mouse */
}

/* ══ the stage — authored at 1920x1080, scaled to whatever panel it lands on ══ */
#fit { position: fixed; inset: 0; }
#stage {
    position: absolute; left: 50%; top: 50%;
    width: 1920px; height: 1080px;
    transform-origin: 50% 50%;
    background: var(--bg);
    color: var(--ink);
    display: flex; flex-direction: column;
    overflow: hidden;
}

/* ══ top bar ══════════════════════════════════════════════════════════════ */
.bar {
    flex: none; height: 118px;
    display: flex; align-items: center; gap: 40px;
    padding: 0 var(--safe);
    background: var(--card);
    border-bottom: 2px solid var(--line);
}
.brand { display: flex; align-items: center; gap: 22px; }
.brand img { height: 46px; width: auto; display: block; }
.brand span {
    font-size: 27px; font-weight: 800; letter-spacing: .4px;
    color: var(--ink-dk); padding-left: 22px; border-left: 2px solid var(--line);
}

/* Where the loop has got to. Doubles as the product's own breadcrumb. */
.steps { display: flex; align-items: center; gap: 14px; margin: 0 auto; }
.steps .step {
    display: flex; align-items: center; gap: 13px;
    padding: 12px 26px 12px 12px; border-radius: 999px;
    background: var(--slate-l); color: var(--slate);
    font-size: 25px; font-weight: 600; white-space: nowrap;
    transition: background .45s ease, color .45s ease;
}
.steps .step b {
    width: 38px; height: 38px; border-radius: 50%;
    background: #D3DBE5; color: var(--slate);
    display: flex; align-items: center; justify-content: center;
    font-size: 21px; font-weight: 800;
    transition: background .45s ease, color .45s ease;
}
.steps .step.on { background: var(--navy); color: #fff; }
.steps .step.on b { background: rgba(255,255,255,.26); color: #fff; }
.steps i { width: 26px; height: 2px; background: #D3DBE5; }

.where { font-size: 23px; color: var(--slate); white-space: nowrap; }
.where em { font-style: normal; font-weight: 800; color: var(--ink-dk); }


/* ══ scenes ═══════════════════════════════════════════════════════════════ */
.area { position: relative; flex: 1 1 auto; }
/* display:none while inactive is deliberate — CSS animations do not run on a
   display:none element and restart cleanly when it is shown again, so every
   loop replays identically with no manual reset. */
.scene { display: none; position: absolute; inset: 0; padding: 26px var(--safe) 18px; }
.scene.on { display: block; }

/* ══ shared furniture ═════════════════════════════════════════════════════ */
.panel {
    position: absolute; top: 26px; bottom: 18px;
    background: var(--card); border: 2px solid var(--line);
    border-radius: var(--r); overflow: hidden;
    display: flex; flex-direction: column;
}
.ph {
    flex: none; display: flex; align-items: center; gap: 16px;
    padding: 22px 28px; border-bottom: 2px solid var(--line);
}
.ph h3 { margin: 0; font-size: 31px; font-weight: 800; letter-spacing: .2px; white-space: nowrap; }
.ph .acc { width: 6px; height: 30px; border-radius: 3px; background: var(--teal); }
.ph .n {
    margin-left: auto; font-size: 22px; color: var(--slate);
    background: var(--slate-l); border-radius: 999px; padding: 6px 16px; font-weight: 700;
    white-space: nowrap;
}
.body { flex: 1 1 auto; padding: 22px 28px; overflow: hidden; }

/* Every code on every screen of this product is monospaced — a part number, a
   QR, a section code, a gate entry. Keep that, it is half the app's texture. */
.mono { font-family: 'Consolas', ui-monospace, 'Courier New', monospace; }
/* Tabular numerals so a column of counts lines up — they are read down. */
.num  { font-variant-numeric: tabular-nums; font-feature-settings: 'tnum' 1; }

.chip {
    display: inline-flex; align-items: center; gap: 8px;
    border-radius: 999px; padding: 7px 16px;
    font-size: 20px; font-weight: 700; line-height: 1;
    white-space: nowrap;
}
.chip.mut  { background: var(--slate-l); color: var(--slate); font-weight: 600; }
.chip.acc  { background: var(--teal-l); color: var(--teal-d); }
.chip.ok   { background: var(--green-l); color: var(--green); border: 1px solid var(--green-b); }
.chip.warn { background: var(--amber-l); color: var(--amber); border: 1px solid var(--amber-b); }
.chip.bad  { background: var(--red-l);   color: var(--red);   border: 1px solid var(--red-b); }
.chip.code { background: var(--slate-l); color: var(--slate);
             font-family: 'Consolas', ui-monospace, monospace; font-weight: 700; }

/* ── the scan field ───────────────────────────────────────────────────────
   On this product almost every operator screen is the same shape: a focused
   QR box, and whatever the scan turned up underneath. It appears in six
   scenes, so it lives here. */
.scan {
    border: 2px solid var(--teal); border-radius: 8px; background: var(--teal-l);
    padding: 16px 20px; display: flex; align-items: center; gap: 16px;
}
.scan .qr { width: 30px; height: 30px; flex: none; color: var(--teal); }
.scan .ph2 { font-family: 'Consolas', ui-monospace, monospace; font-size: 24px;
             color: var(--teal-d); opacity: .62; }
.scan .ph2.typed { opacity: 1; font-weight: 700; }
.scan .car { width: 2px; height: 27px; background: var(--teal-d);
             animation: blink 1.06s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }

/* ── a verdict button pair — Accept / Reject, as three benches draw it ──── */
.vd { display: flex; gap: 16px; }
.vd b {
    flex: 1 1 0; border-radius: 8px; padding: 16px 0; text-align: center;
    font-size: 26px; font-weight: 800; letter-spacing: .6px;
    display: flex; align-items: center; justify-content: center; gap: 12px;
}
.vd b.a { background: var(--green-l); color: var(--green); border: 2px solid var(--green-b); }
.vd b.r { background: var(--red-l);   color: var(--red);   border: 2px solid var(--red-b); }
.vd b kbd { font-family: 'Consolas', ui-monospace, monospace; font-size: 17px;
            font-weight: 700; border: 1px solid currentColor; border-radius: 4px;
            padding: 2px 7px; opacity: .7; }

/* ── entrances. --d is the beat, set per element. ── */
@keyframes rise  { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
@keyframes slide { from { opacity: 0; transform: translateX(-44px); } to { opacity: 1; transform: none; } }
@keyframes pop   { 0% { opacity: 0; transform: scale(.9); } 70% { transform: scale(1.02); } 100% { opacity: 1; transform: scale(1); } }
@keyframes fade  { from { opacity: 0; } to { opacity: 1; } }
[data-in] { opacity: 0; animation-duration: .62s; animation-fill-mode: both;
            animation-timing-function: cubic-bezier(.2,.75,.3,1); animation-delay: var(--d, 0s); }
[data-in="rise"]  { animation-name: rise; }
[data-in="slide"] { animation-name: slide; }
[data-in="pop"]   { animation-name: pop; }
[data-in="fade"]  { animation-name: fade; }

/* Attention beats. Kept slow and few — a TV loop that blinks is exhausting. */
@keyframes glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(14,138,114,0); }
    50%      { box-shadow: 0 0 0 10px rgba(14,138,114,.20); }
}
@keyframes grow  { to { width: var(--w); } }
@keyframes growh { to { height: var(--h); } }
@keyframes draw  { to { stroke-dashoffset: 0; } }

/* ══ the interstitial ══════════════════════════════════════════════════════
   A card between demos saying what is about to happen. Somebody walking past
   arrives mid-loop with no idea what they are looking at; six seconds of plain
   words costs the loop very little and is the difference between a screen
   people glance at and one they stop for. */
#tx { padding: 0; }
.tx {
    position: absolute; inset: 0;
    background: linear-gradient(140deg, #061420 0%, #123A5C 54%, #0E8A72 132%);
    color: #fff;
    display: flex; flex-direction: column; justify-content: center;
    padding: 0 128px;
}
/* a route, as a ground — the shape the whole product is about */
.tx .deco { position: absolute; right: -150px; top: -240px; width: 1060px; height: 1060px;
            opacity: .16; color: var(--teal-br); }
.tx .n {
    font-size: 27px; font-weight: 800; letter-spacing: 5.5px; text-transform: uppercase;
    color: var(--teal-br);
}
.tx h1 {
    margin: 18px 0 0; font-size: 76px; line-height: 1.06; font-weight: 300;
    letter-spacing: -1.4px; max-width: 1400px;
}
.tx h1 b { display: block; font-weight: 800; }
.tx ul { margin: 46px 0 0; padding: 0; list-style: none; max-width: 1480px; }
.tx li {
    display: flex; align-items: flex-start; gap: 24px;
    font-size: 40px; line-height: 1.36; color: #CFE0DC; margin-bottom: 26px;
}
.tx li i {
    flex: none; width: 18px; height: 18px; border-radius: 50%;
    background: var(--teal-br); margin-top: 17px;
}

/* ══ caption strip — the only thing a passer-by reads ═════════════════════ */
.cap {
    flex: none; height: 158px;
    display: flex; align-items: center; gap: 40px;
    padding: 0 var(--safe);
    background: var(--ink-dk); color: #fff;
}
.cap h2 { margin: 0; font-size: 46px; font-weight: 800; letter-spacing: -.4px; line-height: 1.1;
          white-space: nowrap; }
.cap p  { margin: 8px 0 0; font-size: 28px; color: #9FBAC8; font-weight: 500; line-height: 1.36; }
/* The strip is a fixed 158px and the scene area is measured against it, so
   copy that will not fit is cut rather than allowed to push the layout. */
.cap .txt { min-width: 0; overflow: hidden; }
.cap .txt.swap { animation: rise .5s cubic-bezier(.2,.75,.3,1) both; }

/* What is on screen the whole time. It is the same part, the same shift and
   the same line in every scene of a chapter — say so. Hidden on an
   interstitial, where there is nothing yet for it to be about. */
.consign {
    margin-left: auto; flex: none;
    display: flex; align-items: center; gap: 26px;
    background: rgba(255,255,255,.07); border: 2px solid rgba(255,255,255,.16);
    border-radius: 14px; padding: 18px 28px;
    transition: opacity .4s ease;
}
.consign .f { text-align: left; }
.consign .k { font-size: 16px; letter-spacing: 1.4px; text-transform: uppercase; color: #8FA9BA; font-weight: 700; }
.consign .v { font-size: 27px; font-weight: 800; margin-top: 4px; white-space: nowrap; }
.consign .v.sm { font-size: 21px; }
body.on-tx .consign { opacity: 0; }

/* ?bare — the furniture off. Everything that explains the loop to somebody
   standing in front of a television is noise inside a page that is already
   explaining itself in the copy beside it. */
body.bare .cap, body.bare .prog { display: none; }

/* ══ loop progress ════════════════════════════════════════════════════════ */
.prog { flex: none; height: 8px; background: #061420; }
.prog i { display: block; height: 100%; width: 0; background: var(--teal-br); }

/* ══ the cut between scenes ═══════════════════════════════════════════════
   A sweep hides the moment a scene is swapped in. Without it the change from
   display:none to display:block is a hard cut, which on a big panel reads as a
   glitch rather than as an edit. */
.wipe {
    position: absolute; inset: 0; z-index: 40; pointer-events: none;
    background: linear-gradient(100deg, transparent 0%, var(--navy) 22%, var(--teal) 50%, var(--navy) 78%, transparent 100%);
    transform: translateX(-115%);
}
.wipe.run { animation: sweep .82s cubic-bezier(.65,0,.35,1) both; }
@keyframes sweep { to { transform: translateX(115%); } }

/* ══ operator hint — fades out and stays out ══════════════════════════════ */
#hint {
    position: fixed; left: 18px; bottom: 14px; z-index: 60;
    color: rgba(255,255,255,.5); font-size: 13px; letter-spacing: .4px;
    animation: fadeout 1s ease 7s both;
}
@keyframes fadeout { to { opacity: 0; } }
body.paused #hint { animation: none; opacity: 1; color: var(--teal-br); }
</style>
