<script>

/* ══════════════════════════════════════════════════════════════════════════
   The tree is four columns, not one tall stack, and its two running meters
   tick. Both are built here rather than typed: the reading strips are six
   values deep, and a card that drifted out of step with its own flash would
   read as a rendering fault rather than as a meter.
   ══════════════════════════════════════════════════════════════════════════ */
(function () {
    'use strict';
    var $ = function (id) { return document.getElementById(id); };
    var BOLT = '&#9889;';
    var BRAND = 'USMIPL-3 (1)';

    /* ── a value that changes ───────────────────────────────────────────────
       Six samples in a strip one line tall with the rest hidden. Six values,
       translate -9em, steps(6): each step moves 1.5em, which is exactly one
       line-height, so it lands on a value rather than between two. */
    function roll(vals, unit) {
        return '<span class="roll">'
             + vals.map(function (v) { return '<b>' + v + '</b>'; }).join('')
             + '</span> <u>' + unit + '</u>';
    }
    function still(v, unit) { return v + ' <u>' + unit + '</u>'; }

    /* LPDC-02 draws 40 A, so its energy counter advances on every sample.
       LPDC-04 draws 0.3 A and advances on three of the six. Wh received never
       goes down — it is a counter, and one that wandered would be a tell. */
    var LEAVES = [
        { grp: 0, n: 'LPDC-02 (150 Kg) - 24 KW', m: 'LPDC-02 (200 Kg) - 24 KW +7.5 KW',
          live: true, p: [
            ['VLN average',     roll(['232.9929', '233.0417', '232.8863',
                                      '233.1204', '232.9518', '233.0776'], 'v')],
            ['Current Average', roll(['40.7094', '40.6318', '40.8842',
                                      '40.7561', '40.6027', '40.7913'], 'i')],
            ['Wh received',     roll(['537427328', '537427336', '537427344',
                                      '537427352', '537427360', '537427368'], 'w')]
          ] },
        { grp: 0, n: 'LPDC-04 (150 Kg) - 24 KW + 7.5 KW', m: 'LPDC-04 (150 Kg) - 24 KW + 7.5 KW',
          live: true, p: [
            ['VLN average',     roll(['234.2847', '234.3519', '234.1962',
                                      '234.4108', '234.2375', '234.3644'], 'v')],
            ['Current Average', roll(['0.305', '0.298', '0.317',
                                      '0.302', '0.294', '0.309'], 'i')],
            ['Wh received',     roll(['148813328', '148813328', '148813336',
                                      '148813336', '148813336', '148813344'], 'w')]
          ] },
        { grp: 0, n: 'LPDC7', m: null, p: [] },
        { grp: 1, n: 'EF-06(500 Kg) 69 Kw', m: 'EF-06', off: true, p: [
            ['VLN average',     still('0', 'v')],
            ['Current Average', still('0', 'i')],
            ['Wh received',     still('0', 'w')]
          ] }
    ];
    var GROUPS = ['LPDC LINE', 'FURNACE BAY'];

    function sectionNode(name, beat, cls) {
        return '<div class="node' + (cls || '') + '" data-in="pop" style="--d:' + beat + 's">'
             + '<div class="nh"><span class="ic3">&#9638;</span>' + name
             + '<span class="acts">&#9998; + <span class="del">&#128465;</span></span></div>'
             + '<div class="asg">Assign Meter</div>'
             + '<div class="bd2">' + BRAND + '</div></div>';
    }

    var leaves = LEAVES.map(function (x, i) {
        return '<div class="leaf' + (x.live ? ' on10' : '') + '" data-in="slide" style="--d:'
             + (0.9 + i * 0.22) + 's">'
             + '<div class="lh"><span class="ic3">&#9638;</span>' + x.n
             + '<span class="bd2">' + BRAND + '</span>'
             + (x.live ? '<span class="livebadge"><i></i>LIVE</span>' : '')
             + (x.off ? '<span class="offbadge">OFF</span>' : '')
             + '<span class="acts">&#9998; + <span class="del">&#128465;</span></span></div>'
             + (x.m ? '<span class="met">' + BOLT + ' ' + x.m + ' &times;</span>'
                    : '<div class="asg">Assign Meter</div>')
             + (x.p.length
                 ? '<div class="par">' + x.p.map(function (p) {
                       return '<span class="k2">' + p[0] + '</span><span class="c">:</span>'
                            + '<span class="v2">' + p[1] + '</span>';
                   }).join('') + '</div>'
                 : '')
             + '</div>';
    });

    /* Level 3 sits opposite the children it owns, so each group node is
       weighted by how many leaves hang off it — three and one here. */
    var counts = [0, 0];
    LEAVES.forEach(function (x) { counts[x.grp]++; });
    var l3 = GROUPS.map(function (g, i) {
        return '<div style="flex:' + counts[i] + ' 1 0;display:flex;flex-direction:column;'
             + 'justify-content:center;min-height:0">'
             + sectionNode(g, 0.7 + i * 0.15, ' grp') + '</div>';
    }).join('');

    $('m1-a1tree').innerHTML =
        '<div class="lvl l1">' + sectionNode('MV PANEL', 0.25) + '</div>'
      + '<div class="wire"></div>'
      + '<div class="lvl l2">' + sectionNode('MELTING FURNACE', 0.45) + '</div>'
      + '<div class="wire fan" style="--t:24%;--b:24%"></div>'
      + '<div class="lvl l3">' + l3 + '</div>'
      + '<div class="wire fan" style="--t:11%;--b:11%"></div>'
      + '<div class="lvl l4">' + leaves.join('') + '</div>';

    $('m1-a1tools').innerHTML = [['&#8646;', 'Change View'], ['&#8597;', 'Expand All'],
        ['&#10005;', 'Collapse All'], ['&#9974;', 'Fit Screen'], ['&#9868;', 'Compact View']]
        .map(function (t, i) {
            return '<span data-in="rise" style="--d:' + (0.4 + i * 0.14) + 's">'
                 + t[0] + ' ' + t[1] + '</span>';
        }).join('');

    /* ── 2 · three ways a load gets counted ─────────────────────────────── */
    /* Constructed, and built to balance: a parent reading 120.00 with 86.20 of
       metered children leaves 33.80 for the two loads that have no meter. */
    var PARENT = 120.00;
    var METERED = [['EF-02', 45.20], ['EF-06', 28.60], ['EF-08', 12.40]];
    var VIRTUAL = ['Blower line', 'Utilities'];
    var meteredTotal = METERED.reduce(function (a, m) { return a + m[1]; }, 0);
    var derived = PARENT - meteredTotal;
    var each = derived / VIRTUAL.length;
    var u = function (n) { return n.toFixed(2); };

    var WAYS = [
        { k: 'Metered', h: 'A meter of its own',
          p: 'Every parameter it reports, decoded from the brand&rsquo;s register map '
           + '&mdash; live on screen and in the log.',
          d: '<div class="sums">'
           + '<div class="r4"><span class="nm4">VLN average</span>'
           + '<span class="vv2">232.9929 v</span></div>'
           + '<div class="r4"><span class="nm4">Current Average</span>'
           + '<span class="vv2">40.7094 i</span></div>'
           + '<div class="r4"><span class="nm4">Wh received</span>'
           + '<span class="vv2">537427328 w</span></div></div>' },
        { k: 'Rolled up', h: 'A section totals its children',
          p: 'Sections nest, so a panel or a whole shop reads as one figure '
           + '&mdash; nobody adds meters up by hand.',
          d: '<div class="mini3">'
           + [34, 52, 28, 44, 68].map(function (h, i) {
                 return '<span style="--h:' + h + '%;--d:' + (1.6 + i * 0.1) + 's"></span>';
             }).join('')
           + '<span class="gh4" style="--h:100%;--d:2.2s"></span></div>'
           + '<div class="sums" style="margin-top:14px"><div class="r4 tot5">'
           + '<span class="nm4">the section</span><span class="vv2">= all of them</span></div></div>' },
        { k: 'Derived', h: 'A virtual meter', hi: true,
          p: 'No device at all: the parent&rsquo;s total less its metered siblings, '
           + 'split across the virtual ones &mdash; working shown.',
          d: '<div class="sums">'
           + '<div class="r4"><span class="nm4">Parent reads</span><span class="vv2">'
           + u(PARENT) + '</span></div>'
           + METERED.map(function (m) {
                 return '<div class="r4 neg"><span class="nm4">less ' + m[0]
                      + '</span><span class="vv2">&minus; ' + u(m[1]) + '</span></div>';
             }).join('')
           + '<div class="r4 tot5"><span class="nm4">left for the rest</span>'
           + '<span class="vv2">' + u(derived) + '</span></div>'
           + VIRTUAL.map(function (v) {
                 return '<div class="r4 out"><span class="nm4">' + v
                      + '</span><span class="vv2">' + u(each) + '</span></div>';
             }).join('') + '</div>' }
    ];
    $('m1-a2ways').innerHTML = WAYS.map(function (w, i) {
        return '<div class="way' + (w.hi ? ' hi3' : '') + '" data-in="rise" style="--d:'
             + (0.3 + i * 0.4) + 's"><div class="k4">' + w.k + '</div>'
             + '<h4>' + w.h + '</h4><p>' + w.p + '</p>'
             + '<div class="dia">' + w.d + '</div></div>';
    }).join('');
}());


/* ══════════════════════════════════════════════════════════════════════════
   The pie, the traces and the table are all generated from ONE dataset — the
   five LPDC meters and their start/end readings for 30/08/2026 — so a slice,
   its percentage, its cost and its row in the table cannot disagree. That is
   the whole reason they are computed rather than typed.
   ══════════════════════════════════════════════════════════════════════════ */
(function () {
    'use strict';
    var $ = function (id) { return document.getElementById(id); };
    /* DEFAULT_PIE_COLORS, in the app's own order */
    var C = ['#3366cc', '#dc3912', '#ff9900', '#109618', '#990099'];
    var TARIFF = 10.14;   /* derived from the capture: 666.81 / 65.76 */

    /* meter, start, end — transcribed from ../images/pie-chart.png */
    var METERS = [
        ['LPDC-01 (150 Kg) - 24 KW',        198126.048, 198152.752],
        ['LPDC-03 (200 Kg) - 24 KW',        180364.704, 180364.704],
        ['LPDC-05 (150 Kg) - 24 KW',        584951.104, 584951.872],
        ['LPDC-08 (200 Kg) - 24 KW + 7.5 KW', 230265.760, 230276.208],
        ['LPDC-02 (150 Kg) - 24 KW',        537399.744, 537427.584]
    ];
    METERS.forEach(function (m) { m.push(+(m[2] - m[1]).toFixed(3)); });   /* [3] units */
    var TOTAL = METERS.reduce(function (a, m) { return a + m[3]; }, 0);
    METERS.forEach(function (m) {
        m.push(m[3] / TOTAL * 100);                       /* [4] share */
        m.push(m[3] * TARIFF);                            /* [5] cost  */
    });

    /* ── 1 · the dashboard list ─────────────────────────────────────────── */
    var RAIL = [['&#9881;', 'Admin'], ['&#9776;', 'Master'], ['&#9638;', 'Workflow'],
                ['&#128202;', 'Dashboards'], ['&#128220;', 'Reports']];
    $('m2-b1rail').innerHTML = RAIL.map(function (r, i) {
        return '<div class="it' + (i === 3 ? ' on7' : '') + '" data-in="fade" style="--d:'
             + (0.15 + i * 0.08) + 's"><div class="ic4">' + r[0] + '</div>'
             + '<div class="lb6">' + r[1] + '</div></div>';
    }).join('');

    /* The five that already exist, from the capture. Each one was made exactly
       the way the next one is about to be. */
    var PAGES = ['LPDC', 'LPG FLOW Meter', 'Current', 'Melting', 'LPDC-Machine'];
    $('m2-b1fly').innerHTML = PAGES.map(function (p, i) {
        return '<div class="fi" data-in="slide" style="--d:' + (0.5 + i * 0.18) + 's">'
             + '<span class="ic5">&#9638;</span>' + p
             + '<span class="acts2">&#9998; &#10005;</span></div>';
    }).join('')
      + '<div class="fi add pulse2" data-in="rise" style="--d:1.6s">'
      + '<span class="ic5">&#43;</span>Dashboard</div>';

    /* the name being typed, one character at a time */
    var NAME = 'Furnace Efficiency';
    $('m2-b1name').innerHTML = NAME.split('').map(function (ch, i) {
        return '<span data-in="fade" style="--d:' + (2.4 + i * 0.055).toFixed(2)
             + 's;animation-duration:.01s">' + (ch === ' ' ? '&nbsp;' : ch) + '</span>';
    }).join('') + '<span class="cur"></span>';

    /* ── 2 · the + menu, item for item ──────────────────────────────────── */
    /* Straight out of dashboard-page.component.html. The icon names are the
       Material ones the app asks for; these are hand-drawn equivalents. */
    var ICONS = {
        pie_chart: '<circle cx="12" cy="12" r="9"/><path d="M12 3v9h9"/>',
        ssid_chart: '<path d="M3 17l4-7 3 4 4-9 3 6 4-3"/>',
        insights: '<path d="M4 19V9M9 19v-6M14 19V5M19 19v-9"/><circle cx="9" cy="13" r="1.6"/>',
        table_view: '<rect x="3" y="4" width="18" height="16" rx="1.5"/><path d="M3 9h18M9 9v11"/>'
    };
    var TYPES = [
        ['pie_chart',  'Pie Chart',                       'pie'],
        ['ssid_chart', 'Line Chart (Live)',               'line'],
        ['insights',   'Line Chart (day-wise Section)',   'day-wise-line'],
        ['table_view', 'Table',                           'table']
    ];
    $('m2-b2menu').innerHTML = TYPES.map(function (t, i) {
        return '<div class="mi' + (i === 0 ? ' pick3' : '') + '" data-in="slide" style="--d:'
             + (0.8 + i * 0.3) + 's"><span class="gi"><svg viewBox="0 0 24 24">'
             + ICONS[t[0]] + '</svg></span>' + t[1]
             + '<span class="code2">' + t[2] + '</span></div>';
    }).join('');

    /* ── 3 · the fields, and what a different tick pattern makes ────────── */
    var FIELDS = [
        ['LPDC-01 (150 Kg) - 24 KW', 1], ['LPDC-03 (200 Kg) - 24 KW', 0],
        ['LPDC-05 (150 Kg) - 24 KW', 1], ['LPDC-08 (200 Kg) - 24 KW + 7.5 KW', 0],
        ['LPDC-02 (150 Kg) - 24 KW', 1], ['LPDC-04 (150 Kg) - 24 KW + 7.5 KW', 1],
        ['LPDC7', 0]
    ];
    $('m2-b3fields').innerHTML = FIELDS.map(function (f, i) {
        return '<div class="fldrow' + (f[1] ? ' on8' : '') + '" data-in="slide" style="--d:'
             + (0.8 + i * 0.16) + 's"><span class="cb"></span>' + f[0]
             + '<span class="fi2">&#9638;</span></div>';
    }).join('');

    /* The three charts on the LPDC page in ../images/dashboard-pie.png — the
       same meters, three tick patterns, three answers. */
    var SAME = [
        { t: '200 Kg line', n: 'five meters', v: '65.76 units', p: [1, 1, 1, 1, 1, 0, 0] },
        { t: '150 Kg',      n: 'four meters', v: '55.57 units', p: [1, 0, 1, 0, 1, 1, 0] },
        { t: 'lpdc',        n: 'four meters', v: '55.31 units', p: [1, 1, 1, 0, 1, 0, 0] }
    ];
    $('m2-b3same').innerHTML = SAME.map(function (s, i) {
        return '<div class="sr" data-in="rise" style="--d:' + (0.6 + i * 0.45) + 's">'
             + '<div class="tt"><b>' + s.t + '</b><span>' + s.n + '</span>'
             + '<em>' + s.v + '</em></div>'
             + '<div class="ticks">' + s.p.map(function (y) {
                   return '<i class="' + (y ? 'y' : '') + '"></i>';
               }).join('') + '</div></div>';
    }).join('');

    /* ── 4 · one page, three chart types ────────────────────────────────── */
    /* A filled pie drawn as a donut whose stroke-width equals its radius: the
       sector is a dash on that stroke, so one circle per slice and the whole
       thing animates by growing the dash. */
    function pie(rows, o) {
        var R = o.r, r = R / 2, circ = 2 * Math.PI * r, run = 0;
        var slices = rows.filter(function (m) { return m[3] > 0; }).map(function (m, i) {
            var len = m[4] / 100 * circ, rest = circ - len;
            var rot = -90 + run / 100 * 360;
            run += m[4];
            return '<circle cx="' + R + '" cy="' + R + '" r="' + r.toFixed(2)
                 + '" fill="none" stroke="' + C[METERS.indexOf(m)] + '" stroke-width="' + R
                 + '" transform="rotate(' + rot.toFixed(2) + ' ' + R + ' ' + R + ')"'
                 + ' style="--circ:' + circ.toFixed(1) + ';--len:' + len.toFixed(1)
                 + ';--rest:' + rest.toFixed(1) + ';--d:' + (o.d + i * 0.18).toFixed(2) + 's"/>';
        }).join('');
        /* a label only where the slice is wide enough to hold one */
        run = 0;
        var labels = rows.filter(function (m) { return m[3] > 0; }).map(function (m) {
            var mid = (run + m[4] / 2) / 100 * 2 * Math.PI - Math.PI / 2;
            run += m[4];
            if (m[4] < 8) return '';
            return '<text class="pl" x="' + (R + Math.cos(mid) * r).toFixed(1) + '" y="'
                 + (R + Math.sin(mid) * r + 5).toFixed(1) + '" text-anchor="middle">'
                 + m[4].toFixed(1) + '%</text>';
        }).join('');
        return '<svg viewBox="0 0 ' + (R * 2) + ' ' + (R * 2) + '">' + slices + labels + '</svg>';
    }

    /* A deterministic trace: the same seed gives the same wiggle every build,
       so the file renders identically and a diff means something changed. */
