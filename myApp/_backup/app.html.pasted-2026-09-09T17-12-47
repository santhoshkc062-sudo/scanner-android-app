<script>

/* ══════════════════════════════════════════════════════════════════════════
   The three tables are built rather than typed. Each is a list of rows with
   one shape, and a hand-written table is where a column drifts out of line
   with its header and nobody notices until it is on a wall.
   ══════════════════════════════════════════════════════════════════════════ */
(function () {
    'use strict';
    function $(id) { return document.getElementById(id); }

    /* ── 1 · the product rail ──────────────────────────────────────────────
       Four of the twelve, the first selected. The chips are the master's own:
       pieces to a box, and the cast weight one of them carries — which is what
       makes a box's weight arithmetic rather than a scale reading. */
    var PRODUCTS = [
        ['HUB FLANGE ASSEMBLY W/DAMPER (HF-2280-DAS) (418702)', 'HF-2280-DA', '12/box', '2.845 KG', 1],
        ['HUB FLANGE (HF-2280-EAS) (418698)',                   'HF-2280-EA', '16/box', '2.310 KG', 0],
        ['PINION FLANGE 08R (PF-1140-DAS) (418712)',            'PF-1140-DA', '20/box', '1.706 KG', 0],
        ['BEARING CAP LH (BC-0960-AS) (418720)',                'BC-0960-A',  '24/box', '0.884 KG', 0]
    ];
    $('s1-d1list').innerHTML = PRODUCTS.map(function (p, i) {
        return '<div class="pcard' + (p[4] ? ' sel' : '') + '" data-in="rise" style="--d:'
             + (0.22 + i * 0.11) + 's">'
             + '<div class="nmp">' + p[0] + '</div>'
             + '<div class="cdp">' + p[1] + '</div>'
             + '<div class="tags"><span>Qty: ' + p[2] + '</span>'
             + '<span class="wt">Cast. Wt: ' + p[3] + '</span></div></div>';
    }).join('');

    $('s1-d1tags').innerHTML = [
        ['code', 'HF-2280-DA'], ['mut', 'Driveline OEM (44120)'],
        ['mut', 'SG iron 500/7'], ['acc', '12 / box'], ['acc', '2.845 KG']
    ].map(function (t, i) {
        return '<span class="chip ' + t[0] + '" data-in="pop" style="--d:'
             + (0.42 + i * 0.08) + 's">' + t[1] + '</span>';
    }).join('');

    /* ── the process map ───────────────────────────────────────────────────
       Operation, the machine that runs it, and the table that machine already
       writes into. That last column is the load-bearing one: an operation is
       only CHECKABLE when its machine carries a table source, so a plant that
       feeds nothing has nothing to wait for and the route check stays out of
       the way. It is also why nobody types a result — the machine already did.

         [ op, process, machine, table, flag ]

       OP 60 is optional for this part: recorded and shown, but with no say in
       whether the piece may be inspected onward. */
    var OPS = [
        ['OP 10', 'Rough turn',       'VTL-01',   'dbo.VTL01_Result',   ''],
        ['OP 20', 'Finish turn',      'VTL-02',   'dbo.VTL02_Result',   ''],
        ['OP 30', 'Drill &amp; tap',  'VMC-03',   'dbo.VMC03_Result',   ''],
        ['OP 40', 'Induction harden', 'IH-01',    'dbo.IH01_Result',    ''],
        ['OP 50', 'Grind',            'GRD-02',   'dbo.GRD02_Result',   ''],
        ['OP 60', 'Dynamic balance',  'BAL-01',   'dbo.BAL01_Result',   'opt'],
        ['OP 70', 'Auto gauge',       'GAUGE-01', 'dbo.Gauge01_Result', 'gauge'],
        ['OP 80', 'Leak test',        'LKT-01',   'dbo.LKT01_Result',   '']
    ];
    var FLAG = {
        opt:   '<span class="fl o">Optional</span>',
        gauge: '<span class="fl g">Auto gauge</span>',
        '':    ''
    };
    $('s1-d1map').innerHTML =
        '<div class="mh"><span>#</span><span>OP</span><span>Process</span>'
      + '<span>Machine</span><span>Reads from</span><span></span></div>'
      + OPS.map(function (o, i) {
            return '<div class="mrow' + (o[4] === 'opt' ? ' opt' : '') + '" data-in="rise" '
                 + 'style="--d:' + (0.55 + i * 0.09) + 's">'
                 + '<span class="sq">' + (i + 1) + '</span>'
                 + '<span class="op">' + o[0] + '</span>'
                 + '<span class="pr">' + o[1] + '</span>'
                 + '<span class="mc">' + o[2] + '</span>'
                 + '<span class="tb">' + o[3] + '</span>'
                 + '<span>' + FLAG[o[4]] + '</span></div>';
        }).join('');

    /* ── 2 · the flow ──────────────────────────────────────────────────────
         [ kind, station, enforcement, highlighted ]
       Eddy Current sits at `warn` on purpose: it is the stage that was just
       inserted, and the note underneath is the reason. */
    var STAGES = [
        ['GP12',         'GP12 &middot; GP12-FINAL',        'block', 0],
        ['MPI',          'MPI &middot; MPI-BENCH-1',        'block', 0],
        ['EDDY CURRENT', 'Eddy Current &middot; EDDY-MAIN', 'warn',  1],
        ['LINE PACKING', 'Line Packing &middot; PACK-L2',   'block', 0]
    ];
    $('s1-d2flow').innerHTML = STAGES.map(function (s, i) {
        var d = 0.3 + i * 0.34;
        return (i ? '<div class="arw" data-in="fade" style="--d:' + (d - 0.08) + 's">&rarr;</div>' : '')
             + '<div class="stg' + (s[3] ? ' hi' : '') + '" data-in="rise" style="--d:' + d + 's">'
             + '<div class="sh"><b>' + (i + 1) + '</b><span class="lb">Stage ' + (i + 1) + '</span>'
             + '<span class="xx">&times;</span></div>'
             + '<div class="kind">' + s[0] + '</div>'
             + '<div class="stn"><span class="gp">&#8942;&#8942;</span>' + s[1]
             + '<span class="xx">&times;</span></div>'
             + '<div class="addst">+ Add station</div>'
             + '<div class="enf">If not cleared<span class="sel8'
             + (s[2] === 'warn' ? ' warn9' : '') + '">' + s[2] + '</span></div></div>';
    }).join('')
      + '<div class="arw" data-in="fade" style="--d:1.6s">&rarr;</div>'
      + '<div class="ghost" data-in="fade" style="--d:1.75s"><em>+</em>Add stage</div>';

    /* The three settings the dropdown offers. The note under the flow talks
       about two of them; a viewer who has just watched one stage sit at "warn"
       is owed the third. */
    $('s1-d2leg').innerHTML = [
        ['b9', 'block', 'The piece is refused at this station, and told which stage it has not cleared.'],
        ['w9', 'warn',  'The piece goes on, and the operator is told anyway. Where a new stage starts.'],
        ['o9', 'off',   'The stage is not consulted at all &mdash; recorded, but never a reason to stop.']
    ].map(function (e, i) {
        return '<div class="enfc" data-in="rise" style="--d:' + (2.0 + i * 0.14) + 's">'
             + '<span class="tag9 ' + e[0] + '">' + e[1] + '</span><p>' + e[2] + '</p></div>';
    }).join('');

    /* ── 3 · the sections table ────────────────────────────────────────────
         [ code, name, mode, customer, isDefault ]
       Two of these run in sequence on one line, which is why the note beside
       the table says what it says. */
